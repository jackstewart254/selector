{
  "manifest_version": 3,
  "name": "Selector",
  "version": "0.6.0",
  "description": "Click a DOM element, its context lands on your clipboard.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "scripting"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Selector — click, then pick an element",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "picker.js",
        "payload.js",
        "vendor/finder.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
