{
  "manifest_version": 3,
  "name": "element-selector",
  "version": "0.4.1",
  "description": "Click a DOM element in Chrome, its context lands on your clipboard.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "scripting"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Select element (click, then pick)"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "picker.js",
        "payload.js",
        "vendor/finder.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
